  <groupId>io.jenkins.plugins</groupId>
  <artifactId>failure-provenance</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>hpi</packaging>

  <name>Failure Provenance</name>
  <description>Shows whether a build failure has been observed in earlier builds.</description>
  <url>https://github.com/shripal7/failure-provenance-plugin</url>

  <properties>
    <jenkins.version>2.479.3</jenkins.version>
    <java.level>17</java.level>
  </properties>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <licenses>
    <license>
      <name>The MIT License</name>
      <url>https://opensource.org/license/mit/</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/shripal7/failure-provenance-plugin.git</connection>
    <developerConnection>scm:git:ssh://git@github.com-personal/shripal7/failure-provenance-plugin.git</developerConnection>
    <url>https://github.com/shripal7/failure-provenance-plugin</url>
    <tag>HEAD</tag>
  </scm>
</project>
